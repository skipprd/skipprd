{
  "name": "mysql-runtime-source",
  "kind": "DataSource",
  "plugin_name": "Mysql",
  "version": "0.1.0-dev",
  "protocol_version": 1,
  "config_schema_version": 1,
  "install_root": "${binary_dir}/../runtime_plugins/cache",
  "artifacts": {
    "darwin-aarch64": {
      "executable": "${binary_dir}/skippr-plugin-data-source-mysql"
    },
    "darwin-x86_64": {
      "executable": "${binary_dir}/skippr-plugin-data-source-mysql"
    },
    "linux-x86_64": {
      "executable": "${binary_dir}/skippr-plugin-data-source-mysql"
    },
    "linux-aarch64": {
      "executable": "${binary_dir}/skippr-plugin-data-source-mysql"
    },
    "windows-x86_64": {
      "executable": "${binary_dir}/skippr-plugin-data-source-mysql.exe"
    }
  },
  "executable": "${binary_dir}/skippr-plugin-data-source-mysql",
  "args": [],
  "supports_schema": false,
  "source_capability": {
    "name": "Mysql",
    "guarantee_tier": "SnapshotThenLogExactOnce",
    "checkpoint_style": "LogNative",
    "bootstrap_style": "AnchoredSnapshot",
    "order_model": "GlobalTotalOrder",
    "supports_deletes": true,
    "event_id_semantics": "LogPosition"
  }
}
