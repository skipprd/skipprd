{
  "name": "snowflake-runtime-sink",
  "kind": "DataSink",
  "plugin_name": "Snowflake",
  "version": "0.1.0-dev",
  "protocol_version": 1,
  "config_schema_version": 1,
  "install_root": "${binary_dir}/../runtime_plugins/cache",
  "artifacts": {
    "darwin-aarch64": { "executable": "${binary_dir}/skippr-plugin-data-sink-snowflake" },
    "darwin-x86_64": { "executable": "${binary_dir}/skippr-plugin-data-sink-snowflake" },
    "linux-x86_64": { "executable": "${binary_dir}/skippr-plugin-data-sink-snowflake" },
    "linux-aarch64": { "executable": "${binary_dir}/skippr-plugin-data-sink-snowflake" },
    "windows-x86_64": { "executable": "${binary_dir}/skippr-plugin-data-sink-snowflake.exe" }
  },
  "executable": "${binary_dir}/skippr-plugin-data-sink-snowflake",
  "args": [],
  "supports_schema": true,
  "sink_capability": {
    "name": "Snowflake",
    "guarantee_tier": "ExactOnceCdcEligible",
    "can_manage_skippr_columns": true,
    "can_maintain_tombstone_tables": true,
    "can_compare_order_tokens": true,
    "supports_transactions": true
  }
}
