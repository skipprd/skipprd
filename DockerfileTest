FROM 536671797322.dkr.ecr.eu-west-2.amazonaws.com/skippr-php:ubuntu-v2.2.6 as test

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update -y && apt-get install -y bash git rsync nodejs npm yarn composer openssh-client

ARG TEST_SUITE

ARG SSH_PRIVATE_KEY

RUN mkdir -p ~/.ssh
RUN echo "${SSH_PRIVATE_KEY}" > /root/.ssh/id_rsa
RUN chmod 700 ~/.ssh && chmod -R 600 ~/.ssh/*
RUN ssh-keyscan github.com >> ~/.ssh/known_hosts && chmod 644 ~/.ssh/known_hosts
RUN ssh-keyscan gitlab.com >> ~/.ssh/known_hosts && chmod 644 ~/.ssh/known_hosts

WORKDIR /usr/src/app
#COPY --from=builder /usr/src/app/ .
COPY . .

#RUN apk add --no-cache $PHPIZE_DEPS \
#RUN pecl install xdebug-2.9.6 \
#	&& docker-php-ext-enable xdebug \
#  && docker-php-ext-install pcntl
#RUN pecl install pcntl

RUN composer install --no-interaction --no-ansi --prefer-dist --no-progress --optimize-autoloader --ignore-platform-reqs

#RUN ./vendor/phpunit/phpunit/phpunit --configuration ./phpunit.xml --coverage-text --colors=never
RUN ./vendor/phpunit/phpunit/phpunit --configuration ./phpunit.xml --coverage-text --testsuite $TEST_SUITE

