{
  "name": "sftp-runtime-sink",
  "kind": "DataSink",
  "plugin_name": "Sftp",
  "version": "0.1.0-dev",
  "protocol_version": 1,
  "config_schema_version": 1,
  "install_root": "${binary_dir}/../runtime_plugins/cache",
  "artifacts": {
    "darwin-aarch64": { "executable": "${binary_dir}/skippr-plugin-data-sink-sftp" },
    "darwin-x86_64": { "executable": "${binary_dir}/skippr-plugin-data-sink-sftp" },
    "linux-x86_64": { "executable": "${binary_dir}/skippr-plugin-data-sink-sftp" },
    "linux-aarch64": { "executable": "${binary_dir}/skippr-plugin-data-sink-sftp" },
    "windows-x86_64": { "executable": "${binary_dir}/skippr-plugin-data-sink-sftp.exe" }
  },
  "executable": "${binary_dir}/skippr-plugin-data-sink-sftp",
  "args": [],
  "supports_schema": false,
  "sink_capability": {
    "name": "Sftp",
    "guarantee_tier": "CdcEncodedOnly",
    "can_manage_skippr_columns": false,
    "can_maintain_tombstone_tables": false,
    "can_compare_order_tokens": false,
    "supports_transactions": false
  }
}
