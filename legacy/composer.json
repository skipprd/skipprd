{
  "name": "skipprd/skipprd",
  "description": "Any data source to any destination",
  "type": "project",
  "authors": [
    {
      "name": "Paul Hudson",
      "email": "paul@skippr.io"
    }
  ],
  "scripts": {
    "phpstan": "vendor/bin/phpstan analyse src tests -c phpstan.neon --level=5 --no-progress",
    "phpunit": "vendor/bin/phpunit --coverage-html coverage/ --coverage-clover clover.xml",
    "phpcs": "vendor/bin/phpcs --standard=PSR2 ./src",
    "phpcbf": "vendor/bin/phpcbf --standard=PSR2 ./src"
  },
  "autoload": {
    "psr-4": {
      "Skipprd\\": "src/Skipprd/",
      "Tests\\": "tests/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "8.1.*",
    "monolog/monolog": "^1.12",
    "wikimedia/avro": "^1.9",
    "league/statsd": "^1.5",
    "aws/aws-sdk-php": "^3.173",
    "guzzlehttp/guzzle": "^7.5.0",
    "spatie/async": "^1.5",
    "codename/parquet": "^0.6.2",
    "nesbot/carbon": "^2.62"
  },
  "require-dev": {
    "fzaninotto/faker": "^1.5",
    "mockery/mockery": "^1.5",
    "phpunit/phpunit": "^9.5",
    "jane-php/open-api-runtime": "^7.3",
    "phpstan/phpstan": "^1.8",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": true
    }
  }
}
