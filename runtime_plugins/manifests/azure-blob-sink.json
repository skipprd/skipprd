{
  "name": "azure-blob-runtime-sink",
  "kind": "DataSink",
  "plugin_name": "AzureBlob",
  "version": "0.1.0-dev",
  "protocol_version": 1,
  "config_schema_version": 1,
  "install_root": "${binary_dir}/../runtime_plugins/cache",
  "artifacts": {
    "darwin-aarch64": {
      "executable": "${binary_dir}/skippr-plugin-data-sink-azure-blob"
    },
    "darwin-x86_64": {
      "executable": "${binary_dir}/skippr-plugin-data-sink-azure-blob"
    },
    "linux-x86_64": {
      "executable": "${binary_dir}/skippr-plugin-data-sink-azure-blob"
    },
    "linux-aarch64": {
      "executable": "${binary_dir}/skippr-plugin-data-sink-azure-blob"
    },
    "windows-x86_64": {
      "executable": "${binary_dir}/skippr-plugin-data-sink-azure-blob.exe"
    }
  },
  "executable": "${binary_dir}/skippr-plugin-data-sink-azure-blob",
  "args": [],
  "supports_schema": false,
  "sink_capability": {
    "name": "AzureBlob",
    "guarantee_tier": "CdcEncodedOnly",
    "can_manage_skippr_columns": false,
    "can_maintain_tombstone_tables": false,
    "can_compare_order_tokens": false,
    "supports_transactions": false
  }
}
