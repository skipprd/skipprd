{
  "plan_key": "picnic/dev/example3/plans/3ed3abb7-1832-4651-a0ab-61c0d8f97f33/20260226T044711Z_model.json",
  "status": "draft",
  "project_snapshot": {
    "model_candidate_selection": {
      "candidate_count": 15,
      "min_score": 70,
      "selected": [
        {
          "insight": "Foundation dim for all customer reporting; keys and PII constraints clarify customer grain and governance.",
          "name": "dim_customer",
          "observation": "Fully driven from stg_customers; only requires binding to actual customer_id and signup/geo columns discovered in models/staging/.",
          "value_score": 100
        },
        {
          "insight": "Central order header dimension enabling 1:1 link between orders, customers, and time-based analyses.",
          "name": "dim_order",
          "observation": "Sourced from stg_orders with flexible status/channel fields; funnel-specific attributes can be added only if corresponding columns exist.",
          "value_score": 100
        },
        {
          "insight": "Primary transactional fact at item grain; basis for revenue, margin, and product analytics.",
          "name": "fct_order_item",
          "observation": "Uses stg_order_items for quantities and prices; revenue fields and constraints parameterized to match discovered price/discount/tax columns and handle partial product joins.",
          "value_score": 100
        },
        {
          "insight": "Order-level fact optimized for core revenue and volume reporting with strong reconciliation to items.",
          "name": "fct_order",
          "observation": "Aggregates from stg_orders and fct_order_item; reconciliation tests allow configurable tolerances to accommodate upstream quirks in taxes/discounts.",
          "value_score": 98
        },
        {
          "insight": "Authoritative daily revenue series for finance and ops dashboards.",
          "name": "mart_revenue_daily",
          "observation": "Aggregates fct_order by order_date and optional channel; refund and status-specific metrics included only if source fields exist, with reconciliation tests parameterized by tolerance.",
          "value_score": 96
        },
        {
          "insight": "Consolidated customer-level spend and activity table for LTV and lifecycle analyses.",
          "name": "mart_customer_lifetime_value",
          "observation": "Uses fct_order and dim_customer; LTV calculations parameterized by available revenue fields and business definition, with simple defaults when net vs gross not clearly distinguished.",
          "value_score": 95
        },
        {
          "insight": "Daily customer-activity mart enabling retention, engagement, and basic cohort-style reporting.",
          "name": "mart_customer_orders_daily",
          "observation": "Depends on fct_order, dim_customer, dim_order; uses discovered order date field (e.g., order_date/order_datetime::date) and enforces 1 row per (customer_id, order_date).",
          "value_score": 94
        },
        {
          "insight": "Wide, analyst-friendly order-item mart for ad-hoc slicing across customer, order, and inferred product attributes.",
          "name": "mart_order_item_enriched",
          "observation": "Joins fct_order_item to dim_order, dim_customer, dim_product_inferred; gracefully handles missing product attributes by keeping them nullable and relaxing RI tests for product.",
          "value_score": 92
        },
        {
          "insight": "Product-performance views for assortment and pricing analytics, even when product attributes are minimal.",
          "name": "mart_product_performance",
          "observation": "Aggregates fct_order_item by product key and time; supports both true product_id and synthetic inferred key, with RI thresholds configurable for partial coverage.",
          "value_score": 91
        },
        {
          "insight": "RFM-based segmentation plus behavior features for targeting and CRM use cases.",
          "name": "mart_customer_segmentation",
          "observation": "Consumes mart_customer_lifetime_value, mart_customer_orders_daily, dim_customer; features computed only from confirmed metrics (recency, frequency, monetary) to avoid dependence on speculative fields.",
          "value_score": 90
        },
        {
          "insight": "Cohort curves to monitor retention and long-term health of customer base.",
          "name": "mart_cohort_retention",
          "observation": "Uses mart_customer_orders_daily and dim_customer; defines cohorts via first_order_date or signup_date based on availability, ensuring periods and rates are bounded and consistent.",
          "value_score": 89
        },
        {
          "insight": "Provides joinable product key and attributes for item-level and product performance analytics, even in degraded-schema mode.",
          "name": "dim_product_inferred",
          "observation": "Built from stg_order_items using available product-like columns; supports fallback to synthetic product key and relaxed RI/uniqueness if product_id or attributes are weak.",
          "value_score": 88
        },
        {
          "insight": "Tracks repeat purchase patterns and time-between-orders for retention strategy.",
          "name": "mart_repeat_purchase_behavior",
          "observation": "Derived from mart_customer_orders_daily and fct_order; period grain (daily/monthly) and repeat flags adapt to discovered date field, with tests to ensure non-negative intervals.",
          "value_score": 87
        },
        {
          "insight": "Normalizes order lifecycle into comparable funnel stages for conversion and drop-off analysis.",
          "name": "mart_order_funnel",
          "observation": "Built from fct_order and dim_order; funnel_stage and stage timestamps derived only when matching status/date columns exist, with accepted_values tests conditioned on discovered vocabularies.",
          "value_score": 86
        },
        {
          "insight": "Centralized KPIs on RI, null rates, and metric reconciliation to monitor GOLD-layer health.",
          "name": "mart_data_quality_kpi_snapshot",
          "observation": "Built from dim_customer, dim_order, fct_order_item, fct_order and dbt-native test metadata or information_schema; avoids dependence on non-guaranteed external test-result tables and uses configurable thresholds per entity.",
          "value_score": 84
        }
      ],
      "selected_count": 15
    }
  },
