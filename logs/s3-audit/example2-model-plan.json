      "selected": [
        {
          "insight": "Define order-level fact directly from models/staging/stg_orders (optionally joined to stg_customers) with explicit revenue/discount/net_amount logic and documented status filters and tolerances.",
          "name": "fct_order",
          "observation": "Core transaction fact needed for almost all sales analytics and reconciliation; uses only staging sources and resolves grain/PK assumptions early.",
          "value_score": 98
        },
        {
          "insight": "Model item-level metrics from models/staging/stg_order_items joined to stg_orders and stg_customers, selecting a canonical PK (order_item_id or order_id+line_number) and standard revenue math shared with fct_order.",
          "name": "fct_order_item",
          "observation": "Enables detailed line-item analysis and robust order vs item reconciliation while remaining staging-only; critical for high-fidelity metrics.",
          "value_score": 97
        },
        {
          "insight": "Refactor as pure dimension sourced only from models/staging/stg_customers with enforced 1-row-per-customer_id grain and strong PK tests.",
          "name": "dim_customer",
          "observation": "High-impact conformed customer dimension for all joins; no GOLD dependencies and aligned with constraint to use only SILVER inputs.",
          "value_score": 95
        },
        {
          "insight": "Compute sales KPIs (orders, revenue, AOV, active customers) straight from stg_orders/stg_order_items with explicit filters (e.g., exclude cancelled/test orders) and clear reconciliation rules and bounds.",
          "name": "agg_sales_summary",
          "observation": "Dashboard-ready aggregate layer that now depends only on staging inputs; high business value once upstream facts are validated.",
          "value_score": 93
        },
        {
          "insight": "Build daily customer-order aggregates directly from stg_orders (and stg_order_items as needed), standardizing timezone and date-truncation, with specified numeric tolerances vs source facts.",
          "name": "fct_customer_order_daily",
          "observation": "Removes prior GOLD-to-GOLD dependencies by aggregating straight from SILVER, providing behavior/time-series features for reporting and modeling.",
          "value_score": 92
        }
      ],
      "selected_count": 5
    }
