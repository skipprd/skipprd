{
  "name": "synapse-runtime-sink",
  "kind": "DataSink",
  "plugin_name": "Synapse",
  "version": "0.1.0-dev",
  "protocol_version": 1,
  "config_schema_version": 1,
  "install_root": "${binary_dir}/../runtime_plugins/cache",
  "artifacts": {
    "darwin-aarch64": { "executable": "${binary_dir}/skippr-plugin-data-sink-synapse" },
    "darwin-x86_64": { "executable": "${binary_dir}/skippr-plugin-data-sink-synapse" },
    "linux-x86_64": { "executable": "${binary_dir}/skippr-plugin-data-sink-synapse" },
    "linux-aarch64": { "executable": "${binary_dir}/skippr-plugin-data-sink-synapse" },
    "windows-x86_64": { "executable": "${binary_dir}/skippr-plugin-data-sink-synapse.exe" }
  },
  "executable": "${binary_dir}/skippr-plugin-data-sink-synapse",
  "args": [],
  "supports_schema": false,
  "sink_capability": {
    "name": "Synapse",
    "guarantee_tier": "ExactOnceCdcEligible",
    "can_manage_skippr_columns": true,
    "can_maintain_tombstone_tables": true,
    "can_compare_order_tokens": true,
    "supports_transactions": true
  }
}
