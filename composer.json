{
  "name": "skipprd/skipprd",
  "description": "Any data source to any destination",
  "type": "project",
  "authors": [
    {
      "name": "Paul Hudson",
      "email": "paul@skippr.io"
    }
  ],
  "scripts": {
    "phpstan": "phpstan analyse src/ -c phpstan.neon --level=4 --no-progress -vvv"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/paulhudson/laravel-pubsub.git"
    },
    {
      "type": "git",
      "url": "git@github.com:skipprd/machine-to-human.git"
    },
    {
      "type": "git",
      "url": "git@gitlab.com:skippr-plugins/data-source-file.git"
    },
    {
      "type": "git",
      "url": "git@gitlab.com:skippr-plugins/data-output-file.git"
    }
  ],
  "autoload": {
    "psr-4": {
      "Skipprd\\": "src/Skipprd/",
      "Tests\\": "tests/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "7.4.*",
    "nesbot/carbon": "^1.26.3",
    "skipprd/machine-to-human": "^1.0.0",
    "skipprd/data-source-file": "dev-develop",
    "skipprd/data-output-file": "dev-develop",
    "wikimedia/avro": "^1.9",
    "league/statsd": "^1.5",
    "monolog/monolog": "^1.12",
    "aws/aws-sdk-php": "^3.173",
    "guzzlehttp/guzzle": "^6.3",
    "segmentio/analytics-php": "^1.7"
  },
  "require-dev": {
    "fzaninotto/faker": "~1.4",
    "mockery/mockery": "1.3.1",
    "phpunit/phpunit": "~7.0",
    "docker-php/docker-php": "^2.0",
    "jane-php/open-api-runtime": "4.2",
    "phpstan/phpstan": "^0.12.99"
  }
}
